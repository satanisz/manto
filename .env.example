# Optional integrations. Offline mode needs no credentials.
MANTO_ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=
MANTO_ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keep private data, snapshots, results, and checkpoints outside Git.
MANTO_DATA_DIR=.manto
